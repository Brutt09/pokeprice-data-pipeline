# Copy to .env. Defaults work with scripts/dev_db.ps1 (local Postgres on 5433).
DATABASE_URL=postgresql+psycopg://pokeprice:pokeprice@localhost:5433/pokeprice
SETS=sv03.5

# Optional: free key from https://dev.pokemontcg.io (higher rate limits)
POKEMONTCG_API_KEY=

# Optional: free eBay developer account (https://developer.ebay.com), production keyset.
# When set, real eBay listings replace the synthetic benchmark listings.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US
