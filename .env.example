# Copy to .env. Defaults work with scripts/dev_db.ps1 (local Postgres on 5433).
DATABASE_URL=postgresql+psycopg://pokeprice:pokeprice@localhost:5433/pokeprice
SETS=sv03.5

# Optional: free key from https://dev.pokemontcg.io (higher rate limits)
POKEMONTCG_API_KEY=

# Graded eBay SOLD data. Free key: https://www.pokemonpricetracker.com/api (100 credits/day).
# Terms: data may be stored locally but not redistributed, so it never goes in git.
POKEPRICETRACKER_API_KEY=
POKEPRICETRACKER_DAILY_CREDITS=90

# Optional: free eBay developer account (https://developer.ebay.com), production keyset.
# When set, real eBay listings replace the synthetic benchmark listings.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# Optional: Slack / Discord / any JSON webhook for alerts (failed stages, DQ failures, new price anomalies)
ALERT_WEBHOOK_URL=
